<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WinNcsiFix</AssemblyName>
    <RootNamespace>WinNcsiFix</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Authors>Mohammad Mehdi Azizi</Authors>
    <Company>TheGreatAzizi</Company>
    <Product>Win NCSI Fix</Product>
    <Description>A fancy Windows NCSI connectivity detection fixer and diagnostic CLI with a rich interactive UI.</Description>
    <RepositoryUrl>https://github.com/TheGreatAzizi</RepositoryUrl>
    <PackageProjectUrl>https://github.com/TheGreatAzizi</PackageProjectUrl>
    <Copyright>Copyright 2026 Mohammad Mehdi Azizi</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>
</Project>
